# Local: docker compose Postgres (npm run db:up)
DATABASE_URL=postgres://payload:payload@127.0.0.1:5433/anabels
# Any long random string. Online, use a different one.
PAYLOAD_SECRET=change-me
# Where "View website" in the admin goes (online default: the Payload version of the site)
SITE_URL=http://localhost:4321
# Live preview: any long random string (online: a different one). Only the CMS needs it.
PREVIEW_SECRET=change-me-too
# Online only (Vercel): set automatically when a Blob store is connected to the project
# BLOB_READ_WRITE_TOKEN=
# Online only: Vercel deploy hook of the Astro site. Saving content triggers a rebuild.
# ASTRO_DEPLOY_HOOK_URL=
