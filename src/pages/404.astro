---
import Base from '../layouts/Base.astro';
import { getSettings, telHref } from '../lib/cms';
const s = await getSettings();
---

<Base title={`Page not found | ${s.businessName}`} description="We couldn't find that page. Try rug cleaning, repairs or visiting our Louisville showroom." noindex>
  <section class="nf wrap">
        <p class="label">Page not found</p>
    <h1>This page has wandered <em>off the rug.</em></h1>
    <p class="lead">The page you were looking for isn't here. These are a good place to start:</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/louisville-rug-cleaning/">Rug cleaning (15% off when you book online)</a></li>
      <li><a href="/hole-or-tear-repair/">Hole or tear repair</a></li>
      <li><a href="/contact/">Visit &amp; contact</a></li>
      <li><a href="/blog/">Blog</a></li>
    </ul>
    <p>Or call us on <a href={telHref(s.phone)}>{s.phone}</a>.</p>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 10vw, 8rem);
    max-width: calc(48rem + 2 * var(--gutter));
    text-align: center;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  ul a {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    padding: 0.45rem 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }
  ul a:hover {
    border-color: var(--gold);
  }
</style>
