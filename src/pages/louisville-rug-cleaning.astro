---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import BookingForm from '../components/BookingForm.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import VisitStrip from '../components/VisitStrip.astro';
import { getCollection } from 'astro:content';
import { getSettings, mustRead, paragraphs, telHref, imageInfo, reader, accent } from '../lib/cms';
import { service } from '../lib/schema';

const s = await getSettings();
const page = await mustRead('cleaning');
const home = await mustRead('home');
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;

const repair = await reader.collections.repairs.read('hole-or-tear-repair');
const post = (await getCollection('posts')).find((p) => p.id === 'the-art-of-rug-cleaning-why-professional-care-matters');
const related = [
  repair && { label: repair.title, url: '/hole-or-tear-repair/', text: repair.intro },
  post && { label: post.data.title, url: `/${post.id}/`, text: post.data.description.split('. ')[0] + '.' },
].filter(Boolean) as { label: string; url: string; text: string }[];

const hero = imageInfo(page.heroImage);
const heroSizes = '(min-width: 1024px) 50vw, 100vw';
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  image={page.heroImage}
  imageAlt={page.heroAlt}
  crumbs={[{ name: 'Rug cleaning', url: '/louisville-rug-cleaning/' }]}
  jsonLd={[
    service({
      name: 'Oriental and area rug cleaning',
      serviceType: 'Rug cleaning',
      description: page.seo.description,
      url,
      s,
    }),
  ]}
  preloadImage={hero ? { href: hero.fallback, srcset: hero.srcset, sizes: heroSizes } : undefined}
>
  <section class="c-hero" aria-labelledby="c-title">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap c-hero-grid">
      <div class="c-hero-text">
        {page.kicker && <p class="label c-kicker">{page.kicker}</p>}
        <h1 id="c-title" class="c-title" set:html={accent(page.heading)} />
        <p class="lead c-lead">{page.lead}</p>
        <ul class="chips c-chips">
          {page.highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="btn-row c-ctas">
          <a class="btn" href="#book">{page.form.heading}</a>
          <a class="btn btn-quiet" href={telHref(s.phone)}><Icon name="phone" /> {s.phone}</a>
        </div>
      </div>
      <figure class="photo c-hero-media">
        <Img src={page.heroImage} alt={page.heroAlt} sizes={heroSizes} priority />
      </figure>
    </div>
  </section>

  <section class="section c-main bg-linen">
    <div class="wrap c-main-grid">
      <div class="c-form">
        <BookingForm heading={page.form.heading} intro={page.form.intro} source="Cleaning page" />
      </div>
      <div class="c-process">
        <h2 set:html={accent(page.process.heading)} />
        <ol class="c-blocks">
          {
            page.process.blocks.map((b, i) => (
              <li class="c-block" data-reveal style={`--i:${i}`}>
                <span class="c-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{b.heading}</h3>
                  {paragraphs(b.body).map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section c-care">
    <div class="wrap split" data-pos={page.process.imagePosition}>
      <figure class="split-media" data-reveal="unveil">
        <Img src={page.process.image} alt={page.process.imageAlt} sizes="(min-width: 900px) 46vw, 100vw" />
      </figure>
      <div class="c-notes">
        <div class="note panel" data-reveal>
          <h2>{page.petNote.heading}</h2>
          <p class="muted">{page.petNote.body}</p>
        </div>
        <div class="note panel note-interval" data-reveal style="--i:1">
          <h2>{page.interval.heading}</h2>
          <p class="muted">{page.interval.body}</p>
          <a class="btn" href="#book">{home.cleaning.primary.label}</a>
        </div>
      </div>
    </div>
  </section>

  <RelatedLinks heading="Also from Anabel's" links={related} />

  <VisitStrip label={home.visit.label} heading={home.visit.heading} intro={home.visit.intro} />
</Base>

<style>
  .c-hero {
    position: relative;
    overflow-x: clip;
    padding-block: 1.5rem clamp(3.5rem, 7vw, 6rem);
    isolation: isolate;
  }
  .glow {
    position: absolute;
    inset: -10% -10% 0 30%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(163, 58, 46, 0.35), transparent 70%),
      radial-gradient(closest-side at 80% 30%, rgba(43, 74, 117, 0.4), transparent 70%);
    pointer-events: none;
  }
  .c-hero-grid {
    display: grid;
    gap: 2.5rem 4.5rem;
    align-items: center;
    padding-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .c-hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .c-title {
    font-size: clamp(2.7rem, 1.6rem + 4vw, 5.2rem);
    max-width: 13ch;
  }
  .c-lead {
    max-width: 42ch;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 1.75rem 0 2rem;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .chips li::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .c-hero-media :global(img) {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 1024px) {
    .c-hero-media :global(img) {
      aspect-ratio: 5 / 6;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .c-kicker,
    .c-title,
    .c-lead,
    .c-chips,
    .c-ctas {
      animation: c-rise 1s var(--ease) both;
    }
    .c-title {
      animation-delay: 0.06s;
    }
    .c-lead {
      animation-delay: 0.16s;
    }
    .c-chips {
      animation-delay: 0.26s;
    }
    .c-ctas {
      animation-delay: 0.34s;
    }
    .c-hero-media {
      animation: c-fade 1.2s ease 0.2s both;
    }
  }
  @keyframes c-rise {
    from {
      transform: translateY(24px);
    }
  }
  @keyframes c-fade {
    from {
      transform: scale(1.03);
    }
  }

  .c-main-grid {
    display: grid;
    gap: 3rem 4rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .c-main-grid {
      grid-template-columns: 1fr 1fr;
    }
    .c-form {
      order: 2;
    }
  }
  .c-blocks {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .c-block {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .c-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--gold);
    line-height: 1.2;
  }
  .c-block h3 {
    margin-bottom: 0.4rem;
  }
  .c-block p {
    color: var(--muted);
  }

  .c-notes {
    display: grid;
    gap: 1.5rem;
    grid-auto-rows: 1fr; /* both notes the same height */
  }
  .note {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  /* photo matches the height of the two notes */
  @media (min-width: 900px) {
    .c-care .split {
      align-items: stretch;
    }
    .c-care .split-media {
      position: relative;
      min-height: 100%;
    }
    .c-care .split-media :global(img) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }
  }
  .note h2 {
    font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.5rem);
  }
  .note-interval .btn {
    margin-top: 1.3rem;
  }
  .c-care .split-media :global(img) {
    aspect-ratio: 4 / 5;
  }
</style>
