---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import DesignerForm from '../components/DesignerForm.astro';
import { getSettings, mustRead, accent, imageInfo, telHref } from '../lib/cms';

const s = await getSettings();
const page = await mustRead('designers');
const hero = imageInfo(page.image);
const heroSizes = '(min-width: 1024px) 50vw, 100vw';
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  image={page.image}
  imageAlt={page.imageAlt}
  crumbs={[{ name: 'Designer program', url: '/designer-program/' }]}
  preloadImage={hero ? { href: hero.fallback, srcset: hero.srcset, sizes: heroSizes } : undefined}
>
  <section class="d-hero" aria-labelledby="d-title">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap d-hero-grid">
      <div class="d-text">
        {page.kicker && <p class="label">{page.kicker}</p>}
        <h1 id="d-title" set:html={accent(page.heading)} />
        <p class="lead">{page.intro}</p>
        <div class="btn-row">
          <a class="btn" href="#apply">Apply now</a>
          <a class="btn btn-quiet" href={telHref(s.phone)}><Icon name="phone" /> {s.phone}</a>
        </div>
      </div>
      <figure class="photo d-media">
        <Img src={page.image} alt={page.imageAlt} sizes={heroSizes} priority />
      </figure>
    </div>
  </section>

  <section class="section bg-linen">
    <div class="wrap d-grid">
      <div class="d-benefits">
        <h2 set:html={accent(page.benefitsHeading)} />
        <ol class="benefits">
          {
            page.benefits.map((b, i) => (
              <li data-reveal style={`--i:${i % 3}`}>
                <span class="b-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ol>
        {
          page.benefitsImage && (
            <figure class="photo d-detail" data-reveal="unveil">
              <Img src={page.benefitsImage} alt={page.benefitsImageAlt} sizes="(min-width: 1024px) 40vw, 100vw" />
            </figure>
          )
        }
      </div>
      <div class="d-form">
        <DesignerForm heading={page.form.heading} intro={page.form.intro} documentsHelp={page.form.documentsHelp} />
      </div>
    </div>
  </section>
</Base>

<style>
  .d-hero {
    position: relative;
    overflow-x: clip;
    isolation: isolate;
    padding-block: 1.5rem clamp(3.5rem, 7vw, 6rem);
  }
  .glow {
    position: absolute;
    inset: -10% -10% 0 30%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(138, 100, 32, 0.35), transparent 70%),
      radial-gradient(closest-side at 80% 30%, rgba(43, 74, 117, 0.4), transparent 70%);
    pointer-events: none;
  }
  .d-hero-grid {
    display: grid;
    gap: 2.5rem 4.5rem;
    align-items: center;
    padding-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .d-hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .d-text h1 {
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.2rem);
  }
  .d-text .lead {
    max-width: 42ch;
    margin-bottom: 1.9rem;
  }
  .d-media :global(img) {
    aspect-ratio: 3 / 2;
  }
  @media (prefers-reduced-motion: no-preference) {
    .d-text > * {
      animation: d-rise 1s var(--ease) both;
    }
    .d-text > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .d-text > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .d-text > :nth-child(4) {
      animation-delay: 0.22s;
    }
  }
  @keyframes d-rise {
    from {
      transform: translateY(24px);
    }
  }
  .d-grid {
    display: grid;
    gap: 3rem 4.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .d-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .benefits {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    gap: 0;
  }
  .benefits li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 0.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    font-weight: 650;
  }
  .b-num {
    font-family: var(--serif);
    font-style: italic;
    color: var(--gold);
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .d-detail {
    max-width: 22rem;
  }
  .d-detail :global(img) {
    aspect-ratio: 3 / 4;
  }
</style>
