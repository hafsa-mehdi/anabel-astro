---
// One route for three kinds of root-level pages, so URLs stay identical to the live site.
// The layout lives in src/views/Slug.astro (shared with the CMS live preview).
import { getCollection } from 'astro:content';
import Slug from '../views/Slug.astro';
import { getAll } from '../lib/cms';

export async function getStaticPaths() {
  const repairs = await getAll('repairs');
  const areas = await getAll('areas');
  const posts = await getCollection('posts');
  return [
    ...areas.map((a) => ({ params: { slug: a.slug }, props: { kind: 'area' as const, slug: a.slug } })),
    ...repairs.map((r) => ({ params: { slug: r.slug }, props: { kind: 'repair' as const, slug: r.slug } })),
    ...posts.map((p) => ({ params: { slug: p.id }, props: { kind: 'post' as const, slug: p.id } })),
  ];
}

const { kind, slug } = Astro.props;
---

<Slug kind={kind} slug={slug} />
