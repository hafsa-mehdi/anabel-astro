---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import BookingForm from '../components/BookingForm.astro';
import SmartLink from '../components/SmartLink.astro';
import ShowroomMap from '../components/ShowroomMap.astro';
import { getSettings, mustRead, telHref, addressLines, absoluteImage, accent, imageInfo, reader } from '../lib/cms';
import { localBusiness } from '../lib/schema';

const s = await getSettings();
const page = await mustRead('visit');
const site = Astro.site!;
const photo = imageInfo(page.image);
const photoSizes = '(min-width: 1024px) 40vw, 100vw';
// Service-area cards: photo and towns come from Keystatic → Service areas
const areaEntries = await reader.collections.areas.all();
const areaCards = s.serviceAreas.map((a) => {
  const e = areaEntries.find((x) => a.url.replace(/\//g, '') === x.slug);
  return { ...a, image: e?.entry.heroImage, alt: e?.entry.heroAlt ?? '', towns: e?.entry.cities ?? [] };
});
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  image={page.image}
  imageAlt={page.imageAlt}
  crumbs={[{ name: 'Visit & contact', url: '/contact/' }]}
  jsonLd={[localBusiness(s, absoluteImage(page.image, site))]}
  preloadImage={photo ? { href: photo.fallback, srcset: photo.srcset, sizes: photoSizes } : undefined}
>
  <section class="v-hero" aria-labelledby="v-title">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap v-hero-grid">
      <div class="v-intro">
        {page.kicker && <p class="label">{page.kicker}</p>}
        <h1 id="v-title" set:html={accent(page.heading)} />
        <p class="lead">{page.intro}</p>

        <ul class="v-contact">
          <li>
            <span class="ic"><Icon name="pin" /></span>
            <div>
              <span class="k">Address</span>
              <a href={s.directionsUrl ?? '#map'}>{addressLines(s).join(', ')}</a>
            </div>
          </li>
          <li>
            <span class="ic"><Icon name="phone" /></span>
            <div>
              <span class="k">Phone</span>
              <a href={telHref(s.phone)}>{s.phone}</a>
            </div>
          </li>
          <li>
            <span class="ic"><Icon name="mail" /></span>
            <div>
              <span class="k">Email</span>
              <a href={`mailto:${s.email}`}>{s.email}</a>
            </div>
          </li>
        </ul>

        <div class="btn-row">
          <a class="btn" href="#book">{page.form.heading}</a>
          <a class="btn btn-quiet" href={s.directionsUrl ?? '#map'}>Get directions</a>
        </div>
      </div>
      <figure class="photo v-photo">
        <Img src={page.image} alt={page.imageAlt} sizes={photoSizes} priority />
      </figure>
    </div>
  </section>

  <section class="v-map" id="map" aria-label="Map">
    <div class="wrap">
      <ShowroomMap label={page.mapLabel} heading={page.hoursHeading} />
    </div>
  </section>

  <section class="section v-book">
    <div class="wrap v-book-grid">
      <div class="v-areas" data-reveal>
        <h2 set:html={accent(page.areasHeading)} />
        <p class="muted">{page.areasIntro}</p>
        <ul class="area-cards">
          {
            areaCards.map((a) => (
              <li>
                <SmartLink href={a.url} class="area-card">
                  <Img src={a.image} alt={a.alt} sizes="(min-width: 1024px) 45vw, 100vw" />
                  <span class="area-text">
                    <span class="area-name">{a.label}</span>
                    {a.towns.length > 0 && <span class="area-towns">{a.towns.slice(0, 4).join(' · ')}</span>}
                  </span>
                </SmartLink>
              </li>
            ))
          }
        </ul>
      </div>
      <BookingForm heading={page.form.heading} intro={page.form.intro} source="Visit page" />
    </div>
  </section>
</Base>

<style>
  .v-hero {
    position: relative;
    overflow-x: clip;
    padding-block: 1.5rem clamp(3rem, 6vw, 5rem);
    isolation: isolate;
  }
  .glow {
    position: absolute;
    inset: -10% 0 0 35%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(43, 74, 117, 0.45), transparent 70%),
      radial-gradient(closest-side at 30% 70%, rgba(163, 58, 46, 0.3), transparent 70%);
    pointer-events: none;
  }
  .v-hero-grid {
    display: grid;
    gap: 2.5rem 5rem;
    align-items: center;
    padding-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .v-hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .v-intro h1 {
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.2rem);
    max-width: 14ch;
  }
  .v-intro .lead {
    max-width: 46ch;
  }
  .v-contact {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1rem;
  }
  .v-contact li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--gold);
  }
  .ic :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .k {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .v-contact li > div {
    min-width: 0;
  }
  .v-contact a {
    overflow-wrap: anywhere;
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration-color: transparent;
  }
  .v-contact a:hover {
    text-decoration-color: currentColor;
  }
  .v-photo :global(img) {
    aspect-ratio: 3 / 4;
    max-height: 36rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .v-intro > * {
      animation: v-rise 1s var(--ease) both;
    }
    .v-intro > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .v-intro > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .v-intro > :nth-child(4) {
      animation-delay: 0.22s;
    }
    .v-intro > :nth-child(5) {
      animation-delay: 0.3s;
    }
    .v-photo {
      animation: v-fade 1.2s ease 0.2s both;
    }
  }
  @keyframes v-rise {
    from {
      transform: translateY(24px);
    }
  }
  @keyframes v-fade {
    from {
      transform: scale(1.03);
    }
  }
  .v-map {
    scroll-margin-top: var(--header-h);
  }
  .v-book-grid {
    display: grid;
    gap: 3rem 4rem;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .v-book-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* The areas column is exactly as tall as the booking card next to it */
  .v-areas {
    display: flex;
    flex-direction: column;
  }
  .area-cards {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    flex: 1;
    display: grid;
    grid-auto-rows: minmax(13rem, 1fr);
    gap: 1rem;
  }
  .area-cards li {
    display: flex;
  }
  .area-cards :global(.area-card) {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
    transition: border-color 0.4s ease;
  }
  .area-cards :global(.area-card img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 1.2s var(--ease);
  }
  .area-cards :global(.area-card)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(22, 18, 15, 0.92) 8%, rgba(22, 18, 15, 0.15) 70%);
  }
  .area-cards :global(.area-card:hover) {
    border-color: rgba(212, 162, 76, 0.6);
  }
  .area-cards :global(.area-card:hover img) {
    transform: scale(1.05);
  }
  .area-text {
    display: grid;
    gap: 0.2rem;
    padding: 1.4rem 1.6rem;
  }
  .area-name {
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--ivory);
  }
  .area-towns {
    font-size: 0.88rem;
    color: var(--gold);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
</style>
