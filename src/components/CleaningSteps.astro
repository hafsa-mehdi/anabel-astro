---
// Homepage cleaning process: all five steps are shown at once (same as on phones).
// On computers a 3D rug unrolls in one smooth motion when the section comes into view.
// Phones, reduced-motion users and browsers without WebGL get a still, unrolled rug.
import { accent } from '../lib/cms';

interface Props {
  label: string;
  heading: string;
  steps: readonly { title: string; text: string }[];
  primary: { label: string; url: string };
  secondary?: { label: string; url: string };
}
const { label, heading, steps, primary, secondary } = Astro.props;
---

<section class="steps-section" data-steps aria-labelledby="steps-title">
  <div class="pin">
    <div class="wrap steps-grid">
      <div class="steps-text">
        <p class="label">{label}</p>
        <h2 id="steps-title" set:html={accent(heading)} />
        <ol class="plist">
          {
            steps.map((st, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="n" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3>{st.title}</h3>
                  <p>{st.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="btn-row">
          <a class="btn" href={primary.url}>{primary.label}</a>
          {
            secondary && (
              <a class="btn btn-quiet" href={secondary.url} data-astro-prefetch="hover">
                {secondary.label}
              </a>
            )
          }
        </div>
      </div>
      <div class="steps-stage" data-steps-stage aria-hidden="true">
        <picture>
          <source
            media="(min-width: 1024px) and (prefers-reduced-motion: no-preference)"
            srcset="/images/hero/rug-rolled-700.webp 700w, /images/hero/rug-rolled-1400.webp 1400w"
            sizes="50vw"
          />
          <img
          class="steps-poster"
          src="/images/hero/rug-flat-700.webp"
          srcset="/images/hero/rug-flat-700.webp 700w, /images/hero/rug-flat-1400.webp 1400w"
          sizes="(min-width: 1024px) 50vw, 92vw"
          width="1400"
          height="967"
          alt=""
          loading="lazy"
          decoding="async"
        />
        </picture>
      </div>
    </div>
  </div>
</section>

<script>
  import type { mountRug as MountRug } from '../scripts/rug3d';
  type Rug = ReturnType<typeof MountRug>;
  let rug: Rug | null = null;
  let cleanup: (() => void) | null = null;

  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      const gl = (c.getContext('webgl2') || c.getContext('webgl')) as WebGLRenderingContext | null;
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!gl;
    } catch {
      return false;
    }
  }

  function init() {
    const section = document.querySelector<HTMLElement>('[data-steps]');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = '1';
    const stage = section.querySelector<HTMLElement>('[data-steps-stage]')!;
    const stillRug = () => stage.querySelector('source')?.remove();
    const wanted =
      window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches && hasWebGL();
    if (!wanted) return stillRug();

    // Fetch three.js a little before the section arrives...
    let mod: Promise<typeof import('../scripts/rug3d')> | null = null;
    const preload = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        preload.disconnect();
        mod = import('../scripts/rug3d');
      },
      { rootMargin: '800px 0px' },
    );
    // ...then unroll the rug in one smooth motion once it is well in view
    const play = new IntersectionObserver(
      async ([e]) => {
        if (!e.isIntersecting) return;
        play.disconnect();
        try {
          const { mountRug } = await (mod ?? import('../scripts/rug3d'));
          if (!stage.isConnected) return;
          rug = mountRug(stage, {
            startT: 0.15,
            delay: 250,
            duration: 3000,
            onReady: () => stage.classList.add('is-live'),
          });
        } catch {
          stillRug();
        }
      },
      { threshold: 0.45 },
    );
    preload.observe(section);
    play.observe(stage);
    cleanup = () => {
      preload.disconnect();
      play.disconnect();
      rug?.dispose();
      rug = null;
    };
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  .steps-section {
    position: relative;
    background: var(--bg2);
    border-block: 1px solid var(--line);
    padding-block: var(--section);
  }
  .steps-grid {
    display: grid;
    gap: 3rem 4rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plist {
    list-style: none;
    margin: 1.4rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .plist li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 0.45rem 0;
  }
  .n {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--gold);
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .plist li:hover .n {
    background: var(--gold);
    color: var(--bg);
  }
  .plist h3 {
    font-size: 1.55rem;
    margin: 0;
  }
  .plist p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .steps-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1400 / 967;
  }
  .steps-stage::after {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 8%;
    height: 18%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(212, 162, 76, 0.16), transparent);
  }
  .steps-stage picture {
    display: block;
    height: 100%;
  }
  .steps-poster {
    width: 100%;
    height: 100%;
    transition: opacity 0.3s ease 0.15s;
  }
  .steps-stage :global(.rug-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .steps-stage.is-live :global(.rug-canvas) {
    opacity: 1;
  }
  .steps-stage.is-live .steps-poster {
    opacity: 0;
  }
</style>
