---
// Responsive <img> for images uploaded through Keystatic (public/images/uploads).
// Resized WebP copies are produced by scripts/optimize-uploads.mjs.
import { imageInfo } from '../lib/cms';

interface Props {
  src: string | null | undefined;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, alt, sizes = '(min-width: 1100px) 50vw, 100vw', priority = false, class: className, style } = Astro.props;
const info = imageInfo(src);
---

{
  info && (
    <img
      src={info.fallback}
      srcset={info.srcset}
      sizes={info.srcset ? sizes : undefined}
      width={info.width}
      height={info.height}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      class={className}
      style={style}
    />
  )
}
