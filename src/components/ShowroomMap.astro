---
// Animated showroom map (MapLibre GL 6 + free OpenFreeMap tiles, no API key).
// The map library loads only when the section is about to scroll into view.
// It first shows the wider area, then flies down to the showroom and slowly circles it.
import Icon from './Icon.astro';
import { getSettings, telHref, hoursText, addressLines, accent } from '../lib/cms';

interface Props {
  label?: string | null;
  heading: string;
  intro?: string | null;
  headingLevel?: 'h1' | 'h2';
}
const { label, heading, intro, headingLevel = 'h2' } = Astro.props;
const s = await getSettings();
const H = headingLevel;
const towns = (s.mapTowns ?? []).map((t) => ({ name: t.name, lng: Number(t.longitude), lat: Number(t.latitude) }));
const store = { lng: Number(s.geo.longitude), lat: Number(s.geo.latitude) };
---

<div class="map-wrap" data-map data-store={JSON.stringify(store)} data-towns={JSON.stringify(towns)}>
  <div class="map" data-map-canvas role="img" aria-label={`Map showing ${s.businessName} at ${addressLines(s).join(', ')}`}>
  </div>
  <div class="map-fallback">
    <a class="btn btn-quiet" href={s.directionsUrl ?? '#'}>Open in Google Maps</a>
  </div>

  <div class="map-card">
    {label && <p class="label">{label}</p>}
    <H class="map-title" set:html={accent(heading)} />
    {intro && <p class="muted">{intro}</p>}
    <p class="addr">{addressLines(s).map((l) => <span>{l}</span>)}</p>
    <dl class="hours">
      {
        s.hours.map((h) => (
          <div>
            <dt>{h.label}</dt>
            <dd>{hoursText(h)}</dd>
          </div>
        ))
      }
    </dl>
    <div class="btn-row">
      <a class="btn" href={s.directionsUrl ?? '#'}>Get directions</a>
      <a class="btn btn-quiet" href={telHref(s.phone)}><Icon name="phone" /> {s.phone}</a>
    </div>
  </div>
</div>

<script>
  import maplibreCss from 'maplibre-gl/dist/maplibre-gl.css?url';
  // MapLibre 6 runs its tile work in a separate worker file; serve it with the site
  import maplibreWorker from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
  type LngLat = { lng: number; lat: number };
  let map: any = null;

  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  async function start(wrap: HTMLElement) {
    const store: LngLat = JSON.parse(wrap.dataset.store!);
    const towns: { name: string; lng: number; lat: number }[] = JSON.parse(wrap.dataset.towns || '[]');
    const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const big = window.matchMedia('(min-width: 900px)').matches;
    const touch = window.matchMedia('(pointer: coarse)').matches;

    // Map styles are loaded as a separate file, only when the map is needed
    if (!document.querySelector('link[data-maplibre-css]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = maplibreCss;
      link.dataset.maplibreCss = '';
      document.head.appendChild(link);
    }
    const mod: any = await import('maplibre-gl');
    const maplibregl = mod.default ?? mod;
    maplibregl.setWorkerUrl(maplibreWorker);
    if (!wrap.isConnected) return;

    const animate = motion && big;
    map = new maplibregl.Map({
      container: wrap.querySelector<HTMLElement>('[data-map-canvas]')!,
      style: 'https://tiles.openfreemap.org/styles/dark',
      center: animate ? [-85.52, 38.27] : [store.lng, store.lat],
      zoom: animate ? 9.2 : 14.2,
      pitch: animate ? 0 : 45,
      bearing: animate ? 0 : -20,
      scrollZoom: false,
      cooperativeGestures: touch,
      attributionControl: { compact: true },
    });
    // The free style references a few optional pattern images; fill them with a blank pixel
    map.on('styleimagemissing', (e: any) => {
      if (!map.hasImage(e.id)) map.addImage(e.id, { width: 1, height: 1, data: new Uint8Array(4) });
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    wrap.classList.add('is-live');

    map.on('load', () => {
      const pin = document.createElement('div');
      pin.className = 'map-pin';
      new maplibregl.Marker({ element: pin }).setLngLat([store.lng, store.lat]).addTo(map);
      if (!animate) return;

      const labels = towns.map((t) => {
        const el = document.createElement('div');
        el.className = 'map-town';
        el.textContent = t.name;
        new maplibregl.Marker({ element: el }).setLngLat([t.lng, t.lat]).addTo(map);
        return el;
      });
      labels.forEach((el, i) => setTimeout(() => el.classList.add('show'), 250 + i * 180));

      setTimeout(() => {
        labels.forEach((el) => el.classList.remove('show'));
        map.flyTo({
          center: [store.lng, store.lat],
          zoom: 15.6,
          pitch: 58,
          bearing: -28,
          duration: 5200,
          essential: true,
          offset: [200, 30],
        });
        map.once('moveend', () => {
          let stop = false;
          const canvas = map.getCanvas() as HTMLCanvasElement;
          ['pointerdown', 'wheel', 'touchstart'].forEach((ev) =>
            canvas.addEventListener(ev, () => (stop = true), { once: true }),
          );
          const spin = () => {
            if (stop || !map) return;
            map.rotateTo(map.getBearing() + 12, { duration: 6000, easing: (t: number) => t });
            map.once('moveend', spin);
          };
          spin();
        });
      }, 2600);
    });
  }

  function init() {
    const wrap = document.querySelector<HTMLElement>('[data-map]');
    if (!wrap || wrap.dataset.ready) return;
    wrap.dataset.ready = '1';
    if (!hasWebGL()) return wrap.classList.add('no-map');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        wrap.classList.add('in');
        start(wrap).catch((err) => {
          console.warn('Map unavailable, showing the address card only.', err);
          wrap.classList.add('no-map');
        });
      },
      { rootMargin: '200px 0px', threshold: 0.01 },
    );
    io.observe(wrap);
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    map?.remove();
    map = null;
  });
</script>

<style>
  .map-wrap {
    position: relative;
    min-height: 600px;
    height: 78vh;
    max-height: 820px;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 70% 45%, rgba(212, 162, 76, 0.08), transparent 40%),
      repeating-linear-gradient(45deg, transparent 0 22px, rgba(243, 237, 226, 0.025) 22px 23px),
      var(--bg2);
  }
  .map {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .is-live .map {
    opacity: 1;
  }
  .map-fallback {
    display: none;
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
  }
  .no-map .map-fallback {
    display: block;
  }
  .map-card {
    position: absolute;
    left: 1.75rem;
    top: 1.75rem;
    bottom: 1.75rem;
    width: min(400px, calc(100% - 3.5rem));
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.25rem 2.1rem;
    background: rgba(30, 25, 21, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: 22px;
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .map-card {
      opacity: 0;
      transform: translateX(-30px);
      transition: opacity 1s var(--ease) 0.4s, transform 1s var(--ease) 0.4s;
    }
    .in .map-card,
    .no-map .map-card {
      opacity: 1;
      transform: none;
    }
  }
  .map-title {
    font-size: clamp(2.2rem, 1.6rem + 1.6vw, 2.9rem);
    margin-bottom: 0.4em;
  }
  .addr {
    margin: 1rem 0 0;
    font-weight: 700;
  }
  .addr span {
    display: block;
  }
  .hours {
    margin: 1.4rem 0 1.6rem;
    border-top: 1px solid var(--line);
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }
  .hours dt {
    font-weight: 700;
  }
  .hours dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 899.98px) {
    .map-wrap {
      height: auto;
      max-height: none;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .map {
      position: relative;
      height: 360px;
      order: 1;
    }
    .map-card {
      position: relative;
      inset: auto;
      width: auto;
      border-radius: 0;
      border: 0;
      border-bottom: 1px solid var(--line);
      padding: 2rem 1.4rem;
    }
    .map-fallback {
      position: relative;
      order: 2;
      padding: 1rem 1.4rem 1.4rem;
      right: auto;
      bottom: auto;
    }
  }

  /* Markers (created by the script, so they need :global) */
  .map-wrap :global(.map-pin) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--madder);
    border: 3px solid var(--ivory);
    box-shadow: 0 0 0 0 rgba(212, 162, 76, 0.7);
    animation: map-pulse 2s infinite;
  }
  @keyframes map-pulse {
    70% {
      box-shadow: 0 0 0 26px rgba(212, 162, 76, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(212, 162, 76, 0);
    }
  }
  .map-wrap :global(.map-town) {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    background: rgba(22, 18, 15, 0.82);
    border: 1px solid rgba(212, 162, 76, 0.4);
    padding: 4px 9px;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .map-wrap :global(.map-town.show) {
    opacity: 1;
  }
  .map-wrap :global(.maplibregl-ctrl-attrib) {
    background: rgba(22, 18, 15, 0.75) !important;
    color: var(--muted) !important;
  }
  .map-wrap :global(.maplibregl-ctrl-attrib a) {
    color: var(--muted) !important;
  }
</style>
