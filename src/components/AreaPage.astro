---
// Template for Keystatic → Service areas → Service area pages (Indiana, Kentucky, ...).
import Img from './Img.astro';
import Icon from './Icon.astro';
import BookingForm from './BookingForm.astro';
import VisitStrip from './VisitStrip.astro';
import { getSettings, mustRead, telHref, accent, paragraphs } from '../lib/cms';

interface Props {
  entry: {
    title: string;
    kicker: string;
    heading: string;
    intro: string;
    heroImage: string | null;
    heroAlt: string;
    citiesHeading: string;
    cities: readonly string[];
    formHeading: string;
    formIntro: string;
  };
}
const { entry } = Astro.props;
const s = await getSettings();
const home = await mustRead('home');
const cleaning = await mustRead('cleaning');
---

<section class="a-hero" aria-labelledby="a-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap a-hero-grid">
    <div class="a-text">
      {entry.kicker && <p class="label">{entry.kicker}</p>}
      <h1 id="a-title" set:html={accent(entry.heading)} />
      <p class="lead">{entry.intro}</p>
      <ul class="chips">
        {cleaning.highlights.map((h) => <li>{h}</li>)}
      </ul>
      <div class="btn-row">
        <a class="btn" href="#book">{entry.formHeading}</a>
        <a class="btn btn-quiet" href={telHref(s.phone)}><Icon name="phone" /> {s.phone}</a>
      </div>
    </div>
    {
      entry.heroImage && (
        <figure class="photo a-media">
          <Img src={entry.heroImage} alt={entry.heroAlt} sizes="(min-width: 1024px) 45vw, 100vw" priority />
        </figure>
      )
    }
  </div>
</section>

<section class="section bg-linen">
  <div class="wrap a-grid">
    <div class="a-info">
      <div data-reveal>
        <h2 set:html={accent(entry.citiesHeading)} />
        <ul class="towns">
          {entry.cities.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="a-how panel" data-reveal style="--i:1">
        <h2 set:html={accent(cleaning.process.heading)} />
        {
          cleaning.process.blocks.map((b) => (
            <div class="how-item">
              <h3>{b.heading}</h3>
              {paragraphs(b.body).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          ))
        }
        <p class="more">
          <a href="/louisville-rug-cleaning/" data-astro-prefetch="hover">More about our rug cleaning</a>
        </p>
      </div>
    </div>
    <div class="a-form">
      <BookingForm heading={entry.formHeading} intro={entry.formIntro} source={entry.title} zip />
    </div>
  </div>
</section>

<VisitStrip label={home.visit.label} heading={home.visit.heading} intro={home.visit.intro} />

<style>
  .a-hero {
    position: relative;
    overflow-x: clip;
    padding-block: 1.5rem clamp(3.5rem, 7vw, 6rem);
    isolation: isolate;
  }
  .glow {
    position: absolute;
    inset: -10% -10% 0 30%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(43, 74, 117, 0.45), transparent 70%),
      radial-gradient(closest-side at 30% 70%, rgba(163, 58, 46, 0.3), transparent 70%);
    pointer-events: none;
  }
  .a-hero-grid {
    display: grid;
    gap: 2.5rem 4.5rem;
    align-items: center;
    padding-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .a-hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .a-text h1 {
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.2rem);
  }
  .a-text .lead {
    max-width: 44ch;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 1.6rem 0 2rem;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .chips li::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .a-media :global(img) {
    aspect-ratio: 4 / 3;
  }
  @media (prefers-reduced-motion: no-preference) {
    .a-text > * {
      animation: a-rise 1s var(--ease) both;
    }
    .a-text > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .a-text > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .a-text > :nth-child(4) {
      animation-delay: 0.22s;
    }
    .a-text > :nth-child(5) {
      animation-delay: 0.3s;
    }
  }
  @keyframes a-rise {
    from {
      transform: translateY(24px);
    }
  }
  .a-grid {
    display: grid;
    gap: 3rem 4.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .a-grid {
      grid-template-columns: 1fr 1fr;
    }
    .a-form {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .a-info {
    display: grid;
    gap: 2.5rem;
  }
  .towns {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .towns li {
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 1.2rem;
  }
  .a-how {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .a-how h2 {
    font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.5rem);
  }
  .how-item {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .how-item h3 {
    font-size: 1.45rem;
    margin-bottom: 0.3rem;
  }
  .how-item p {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .more {
    margin-top: 1rem;
    font-weight: 800;
  }
</style>
