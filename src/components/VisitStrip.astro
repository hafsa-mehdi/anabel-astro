---
// Compact "visit the showroom" band used at the bottom of inner pages.
import Icon from './Icon.astro';
import { getSettings, telHref, hoursText, addressLines, accent } from '../lib/cms';

interface Props {
  heading: string;
  intro?: string | null;
  label?: string | null;
  image?: string | null;
  imageAlt?: string | null;
}
const { heading, intro, label } = Astro.props;
const s = await getSettings();
---

<section class="section visit-strip" aria-labelledby="visit-title">
  <div class="wrap">
    <div class="strip panel" data-reveal>
      <div class="v-text">
        {label && <p class="label">{label}</p>}
        <h2 id="visit-title" set:html={accent(heading)} />
        {intro && <p class="muted">{intro}</p>}
        <p class="v-addr">
          <Icon name="pin" />
          <span>{addressLines(s).map((l) => <span class="line">{l}</span>)}</span>
        </p>
        <div class="btn-row">
          <a class="btn" href={s.directionsUrl ?? '/contact/'}>Get directions</a>
          <a class="btn btn-quiet" href={telHref(s.phone)}><Icon name="phone" /> {s.phone}</a>
        </div>
      </div>
      <div>
      <dl class="v-hours">
        {
          s.hours.map((h) => (
            <div data-closed={h.closed ? '' : undefined}>
              <dt>{h.label}</dt>
              <dd>{hoursText(h)}</dd>
            </div>
          ))
        }
      </dl>
      <p class="v-more"><a href="/contact/" data-astro-prefetch="hover">Map, email and service areas</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .visit-strip {
    padding-top: 0;
  }
  /* after a section with its own background, leave clear space instead of touching its edge */
  :global(.bg-linen) + .visit-strip,
  :global(.bg-wool) + .visit-strip {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .strip {
    display: grid;
    gap: 2rem 4rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .strip {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .v-addr {
    display: flex;
    gap: 0.6rem;
    font-weight: 700;
    margin: 1.2rem 0 1.5rem;
  }
  .v-addr :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.2rem;
    color: var(--gold);
  }
  .v-addr .line {
    display: block;
  }
  .v-hours {
    margin: 0;
  }
  .v-hours div {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .v-hours dt {
    font-weight: 700;
  }
  .v-hours dd {
    margin: 0;
    color: var(--muted);
  }
  .v-more {
    margin-top: 1.1rem;
    font-weight: 700;
  }
</style>
